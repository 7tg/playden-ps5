{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "legacy-host",
      "displayName": "Legacy RmlFocus macOS host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLAYDEN_HOMEBREW_UI": "OFF",
        "PLAYDEN_PLATFORM_PS5": "OFF",
        "PLAYDEN_DEVELOPER_FIXTURES": "OFF"
      }
    },
    {
      "name": "legacy-host-fixtures",
      "inherits": "legacy-host",
      "displayName": "Legacy RmlFocus macOS development fixtures",
      "binaryDir": "${sourceDir}/build/host-fixtures",
      "cacheVariables": {
        "PLAYDEN_DEVELOPER_FIXTURES": "ON"
      }
    },
    {
      "name": "homebrew-host",
      "displayName": "Selected direct Hui macOS host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/homebrew-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLAYDEN_HOMEBREW_UI": "ON",
        "PLAYDEN_UI_SIMULATION": "OFF",
        "PLAYDEN_PLATFORM_PS5": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "legacy-host",
      "configurePreset": "legacy-host"
    },
    {
      "name": "legacy-host-fixtures",
      "configurePreset": "legacy-host-fixtures"
    },
    {
      "name": "homebrew-host",
      "configurePreset": "homebrew-host"
    }
  ],
  "testPresets": [
    {
      "name": "legacy-host",
      "configurePreset": "legacy-host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "legacy-host-fixtures",
      "configurePreset": "legacy-host-fixtures",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "homebrew-host",
      "configurePreset": "homebrew-host",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
