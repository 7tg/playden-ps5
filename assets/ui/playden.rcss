div, h1, p { display: block; }
body { width: 100%; height: 100%; margin: 0; background-color: #0b1019; color: #edf2fa; font-family: Inter; font-size: 24dp; }
.header { position: absolute; left: 96dp; right: 96dp; top: 60dp; height: 68dp; display: flex; align-items: center; }
.brand { font-size: 36dp; font-weight: bold; width: 300dp; color: #a9c9ff; }
.rf-tabbar { display: flex; }
button { tab-index: auto; display: block; background-color: #202c40; border: 3dp #202c40; border-radius: 10dp; padding: 20dp 28dp; margin-right: 20dp; color: #edf2fa; font-size: 26dp; }
button:focus { border-color: #d5e6ff; background-color: #354c70; }
button[pressed] { background-color: #56749c; }
.rf-tabbar button { background-color: #0b1019; border-color: #0b1019; padding: 12dp 26dp; }
.rf-tabbar button.selected { color: #a9c9ff; background-color: #1b2940; }
.rf-tabbar button:focus { border-color: #d5e6ff; }
.content { position: absolute; left: 96dp; right: 96dp; top: 260dp; }
.eyebrow { color: #a9c9ff; font-size: 22dp; margin-bottom: 22dp; }
h1 { font-size: 72dp; margin: 0 0 24dp; }
p { color: #a8b8cf; font-size: 28dp; margin: 0 0 38dp; max-width: 1250dp; line-height: 1.5; }
.actions { display: flex; margin-top: 36dp; }
#diagnostic { position: absolute; left: 96dp; right: 96dp; bottom: 160dp; color: #ffd38a; font-size: 24dp; }
.hints { position: absolute; left: 96dp; bottom: 62dp; color: #a8b8cf; font-size: 22dp; }
.version { position: absolute; right: 96dp; bottom: 62dp; color: #7890b0; font-size: 20dp; }
body.modal { background-color: #050912dd; }
.sheet { position: absolute; left: 360dp; right: 360dp; top: 270dp; background-color: #192538; border: 2dp #415778; border-radius: 20dp; padding: 64dp; }
.sheet h1 { font-size: 48dp; }
.modal .hints { right: 96dp; bottom: 50dp; padding: 12dp 0; background-color: #0b1019; }
.library-page { position: absolute; left: 80dp; right: 80dp; top: 145dp; bottom: 70dp; display: block; }
.library-page h1 { font-size: 52dp; margin-bottom: 4dp; }
.library-summary { font-size: 20dp; margin-bottom: 4dp; }
#library-fixture { display: none; position: absolute; right: 0; top: 0; margin: 0; }
#library-grid { display: block; width: 100%; height: 700dp; overflow: hidden; }
.game-tile { width: 220dp; height: 300dp; padding: 0; overflow: hidden; border: 3dp #263650; border-radius: 10dp; background-color: #151f30; }
.rf-collection-item:focus .game-tile { border-color: #d5e6ff; background-color: #263b5c; }
.game-art { display: block; width: 214dp; height: 230dp; background-color: #202c40; }
.game-art-missing { color: #7890b0; text-align: center; padding-top: 96dp; height: 134dp; font-size: 16dp; }
rf-image:loading { background-color: #202c40; }
rf-image:error { background-color: #472b35; }
.game-title { display: block; margin: 10dp 12dp; height: 48dp; line-height: 1.25; font-size: 18dp; overflow: hidden; }
.details-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #202c40; }
.details-scrim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #07101ad9; }
.details-copy { position: absolute; left: 100dp; top: 190dp; width: 1500dp; display: block; }
.details-copy h1 { font-size: 64dp; margin-bottom: 16dp; }
.details-developer { color: #a9c9ff; font-size: 26dp; margin-bottom: 18dp; }
.details-description { font-size: 28dp; max-width: 1450dp; max-height: 180dp; overflow: hidden; }
.fixture-banner { display: block; color: #ffd38a; background-color: #33291b; border: 3dp #8f713c; border-radius: 12dp; padding: 16dp 22dp; margin: 24dp 0; font-size: 26dp; }
.confirmation { position: absolute; left: 360dp; right: 360dp; top: 270dp; background-color: #192538; border: 3dp #6c82a3; border-radius: 22dp; padding: 64dp; }
.confirmation h1 { font-size: 58dp; }
.progress-track { display: block; width: 100%; height: 48dp; background-color: #0b1019; border-radius: 24dp; overflow: hidden; margin: 38dp 0 20dp; }
.progress-bar { display: block; height: 48dp; width: 0%; background-color: #7eb4ff; }

.library-search { position: absolute; right: 0dp; top: 80dp; max-width: 650dp; overflow: hidden; white-space: nowrap; }
.search-page { display: block; margin: 70dp 140dp; }
.search-value { display: block; margin: 25dp 0dp; padding: 20dp; min-height: 42dp; background: #182337; border-radius: 10dp; font-size: 34dp; overflow: hidden; }
rf-keyboard { display: block; position: relative; width: 1500dp; height: 510dp; margin-top: 30dp; }
.rf-keyboard-key { position: absolute; width: 135dp; height: 80dp; padding: 0dp; margin: 0dp; text-align: center; line-height: 80dp; font-size: 28dp; }
.rf-keyboard-key[data-row="0"] { top: 0dp; }
.rf-keyboard-key[data-row="1"] { top: 100dp; }
.rf-keyboard-key[data-row="2"] { top: 200dp; }
.rf-keyboard-key[data-row="3"] { top: 300dp; }
.rf-keyboard-key[data-row="4"] { top: 400dp; }
.rf-keyboard-key[data-column="0"] { left: 0dp; }
.rf-keyboard-key[data-column="1"] { left: 150dp; }
.rf-keyboard-key[data-column="2"] { left: 300dp; }
.rf-keyboard-key[data-column="3"] { left: 450dp; }
.rf-keyboard-key[data-column="4"] { left: 600dp; }
.rf-keyboard-key[data-column="5"] { left: 750dp; }
.rf-keyboard-key[data-column="6"] { left: 900dp; }
.rf-keyboard-key[data-column="7"] { left: 1050dp; }
.rf-keyboard-key[data-column="8"] { left: 1200dp; }
.rf-keyboard-key[data-column="9"] { left: 1350dp; }
.rf-keyboard-key[data-column-span="2"] { width: 285dp; }
.rf-keyboard-key[data-column-span="4"] { width: 585dp; }
