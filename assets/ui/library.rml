<rml><head><title>Playden — Library</title><link type="text/rcss" href="playden.rcss"/></head><body><div class="header"><span class="brand">playden</span><div class="rf-tabbar"><button id="home-tab">Home</button><button id="library-tab">Library</button><button id="settings-tab">Settings</button></div></div><main class="library-page"><div class="eyebrow">YOUR LIBRARY</div><h1>Choose a game</h1><p class="library-summary">Browse your games and select a title to see its details.</p><div id="library-fixture" class="fixture-banner">DEVELOPMENT FIXTURE · SYNTHETIC LIBRARY</div><button id="search-button" class="library-search">Search</button><div id="library-empty"><p id="library-empty-message">Steam is not connected. Your owned library will appear here after sign-in is available.</p><button id="library-status">Connection status</button></div><rf-grid id="library-grid" columns="7" item-width="220" item-height="320" gap="24" lift-margin="28" overscan="1" snap="nearest" focus-section=""/></main><div id="diagnostic"></div><div class="hints">L1 / R1  Sections  ·  D-pad  Browse  ·  Cross  Details  ·  Triangle  Search  ·  Circle  Back</div><div class="version">REPRESENTATIVE SCENE / 02</div></body></rml>
