<rml><head><title>Playden — Settings</title><link type="text/rcss" href="playden.rcss"/></head><body><div class="header"><span class="brand">playden</span><div class="rf-tabbar"><button id="home-tab">Home</button><button id="library-tab">Library</button><button id="settings-tab">Settings</button></div></div><div class="content"><div class="eyebrow">MAKE YOURSELF AT HOME</div><h1 id="page-title">Settings</h1><p id="page-intro">Choose how Playden moves. Changes are saved on this device.</p><div class="actions"><button id="reduce-motion">Reduce motion: <span id="motion-value">Off</span></button><button id="exit-button">Exit Playden</button></div></div><div id="diagnostic"></div><div class="hints">L1 / R1  Sections  ·  D-pad  Navigate  ·  Cross  Select  ·  Circle  Back</div><div class="version">FOUNDATION / 01</div></body></rml>