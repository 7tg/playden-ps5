<rml><head><title>Playden — Game details</title><link type="text/rcss" href="playden.rcss"/></head><body><rf-image id="details-art" class="details-art" fit="cover"/><div class="details-scrim"/><main class="details-copy"><div class="eyebrow">GAME DETAILS</div><h1 id="details-title">Game</h1><p id="details-developer" class="details-developer">Developer</p><p id="details-description" class="details-description">Description</p><div id="fixture-notice" class="fixture-banner">DEVELOPMENT FIXTURE · NO FILES WILL BE INSTALLED</div><div class="actions"><button id="details-install">Install fixture</button><button id="details-back">Back to library</button></div></main><div class="hints">Cross  Select  ·  Circle  Back</div></body></rml>
